###
# BUILD STAGE
###

# Get golang image
FROM golang:1.27.3-alpine AS builder

# CGo disabled so goose is built as a static binary with no C dependencies.
ENV CGO_ENABLED=0

# Install goose, pinned to the version used locally so migrations behave the same everywhere.
RUN go install github.com/pressly/goose/v3/cmd/goose@v3.29.0

###
# RUN STAGE
###

FROM alpine:3.24.4

# Non-root user, numeric UID so Kubernetes runAsNonRoot can verify it
RUN addgroup -g 10003 migrategroup && \
    adduser -u 10003 -G migrategroup -h /home/migrateuser -D migrateuser

WORKDIR /migrations

# Copy only the goose binary from the build stage
COPY --from=builder /go/bin/goose /usr/local/bin/goose

# Copy the migration files (build context is backend/)
COPY --chown=migrateuser:migrategroup migrations/ ./

USER migrateuser

# goose reads these from the environment, set by docker-compose:
#   GOOSE_DRIVER   (postgres)
#   GOOSE_DBSTRING (postgres://user:password@db:5432/dbname?sslmode=disable)
# Run all pending migrations and exit. This is a one-shot job, not a long-running service.
CMD ["goose", "-dir", "/migrations", "up"]
