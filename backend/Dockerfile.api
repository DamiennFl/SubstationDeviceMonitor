###
# BUILD STAGE
###

FROM golang:1.27.3-alpine AS builder

WORKDIR /api

COPY go.mod go.sum ./

RUN go mod download

COPY . .

ENV CGO_ENABLED=0

RUN go build -o main ./cmd/api

###
# RUN STAGE
###

FROM alpine:3.24.4

RUN addgroup -g 10002 apigroup && \
        adduser -u 10002 -G apigroup -h /home/apiuser -D apiuser

WORKDIR /api

COPY --from=builder --chown=apiuser:apigroup ./api/main .

USER apiuser

CMD ["./main"]